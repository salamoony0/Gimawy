# Local Postgres from `npm run db`. For Supabase use the pooled URL (port 6543, add ?pgbouncer=true) here
# and the direct URL (port 5432) in DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gymawy"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/gymawy"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
AI_DAILY_LIMIT=40
# Password reset emails (https://resend.com). Without a key, reset links are printed to the server log.
RESEND_API_KEY=""
MAIL_FROM="Gymawy <onboarding@resend.dev>"
# Public URL of the client, used in emailed links
APP_URL="http://localhost:5173"
# Proxy hops to trust for client IPs (rate limits). Defaults to 1 in production.
# TRUST_PROXY=1
# RATE_LIMIT=off disables rate limiting (tests only)
